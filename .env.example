# Memy configuration. The setup scripts (scripts/setup.sh, scripts/setup.ps1) create .env from this file and
# generate every secret for you; only the API keys need your input. Never commit .env.

# --- Secrets (generated by the setup script) ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
MASTER_KEY=

# --- Seeded accounts (created on first start; passwords generated by the setup script) ---
SEED_ADMIN_EMAIL=admin@memy.local
SEED_ADMIN_PASSWORD=
SEED_ALICE_EMAIL=alice@memy.local
SEED_ALICE_PASSWORD=
SEED_BOB_EMAIL=bob@memy.local
SEED_BOB_PASSWORD=

# --- Model providers ---
# Required: all agents run on Groq (free key at https://console.groq.com/keys).
GROQ_API_KEY=
# Optional: speech, sound effects, transcription, music/image/video (https://elevenlabs.io/app/settings/api-keys).
ELEVENLABS_API_KEY=
